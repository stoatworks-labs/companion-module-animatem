{
  "name": "companion-module-animatem",
  "version": "1.0.5",
  "main": "dist/main.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "format": "prettier -w .",
    "build": "rimraf dist && tsc -p tsconfig.build.json && cp src/about-field.js src/about-field.d.ts dist/",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "companion-module-build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@companion-module/base": "^2.2.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@companion-module/tools": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoatworks-labs/companion-module-animatem.git"
  }
}
